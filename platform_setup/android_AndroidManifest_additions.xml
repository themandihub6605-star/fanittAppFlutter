<!-- android/app/src/main/AndroidManifest.xml -->

<!-- 1. Directly inside <manifest>, above <application> (release builds need it): -->
<uses-permission android:name="android.permission.INTERNET"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

<!-- 2. Inside <manifest>, so links, email and Zoom can open: -->
<queries>
  <intent>
    <action android:name="android.intent.action.VIEW" />
    <data android:scheme="https" />
  </intent>
  <intent>
    <action android:name="android.intent.action.SENDTO" />
    <data android:scheme="mailto" />
  </intent>
</queries>

<!-- 3. For a local http backend in debug only, in android/app/src/debug/AndroidManifest.xml:
<application android:usesCleartextTraffic="true" /> -->

<!-- 4. Inside <application>: default channel + accent for push notifications -->
<meta-data
    android:name="com.google.firebase.messaging.default_notification_channel_id"
    android:value="fanitt_default" />
<meta-data
    android:name="com.google.firebase.messaging.default_notification_color"
    android:resource="@color/notification_accent" />

